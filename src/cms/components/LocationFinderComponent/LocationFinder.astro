---
import type { DisplaySettingsFragment } from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';
import { bfsLocations } from '../../../data/bfs-locations.ts';

export interface Props {
    key: string;
    data: any;
    contentPayload: ContentPayload;
    displaySettings: DisplaySettingsFragment[];
}

const { key } = Astro.props as Props;
const isCmsEdit = isEditContext(Astro.url);

// Support both /location/86401/ slug and ?zip=86401 querystring
const pathZip = Astro.url.pathname.match(/\/location\/(\d{5})\/?/)?.[1] ?? '';
const zip = pathZip || (Astro.url.searchParams.get('zip')?.trim() ?? '');
const results = zip ? bfsLocations.filter((loc) => loc.zip === zip) : [];
const mapAddress = results.length > 0 ? encodeURIComponent(results[0].address) : null;
---

<div class="component-location-finder w-full px-4 py-10 max-w-screen-xl mx-auto 2xl:px-0" data-epi-block-id={isCmsEdit && key || undefined}>

    {zip && results.length === 0 && (
        <div class="alert alert-warning max-w-lg mb-8">
            <span>No Builders FirstSource locations found for ZIP code <strong>{zip}</strong>.</span>
        </div>
    )}

    {results.length > 0 && (
        <div class="mb-10">
            <p class="text-sm text-base-content/60 mb-6">
                {results.length} location{results.length !== 1 ? 's' : ''} found for ZIP <strong>{zip}</strong>
            </p>

            <div class="flex flex-col lg:flex-row gap-6 w-full">
                {/* Location cards */}
                <div class={`flex flex-col gap-6 ${results.length === 1 ? 'lg:w-1/2' : 'w-full'}`}>
                    {results.map((loc) => (
                        <div class="card bg-base-100 border border-base-300 shadow-sm h-full">
                            <div class="card-body gap-3">
                                <h2 class="card-title text-lg font-semibold leading-snug">{loc.name}</h2>

                                <address class="not-italic text-sm text-base-content/80 leading-snug">
                                    {loc.address}
                                </address>

                                {loc.phone && (
                                    <a href={`tel:${loc.phone}`} class="text-sm font-medium text-primary hover:underline">
                                        {loc.phone}
                                    </a>
                                )}

                                <div class="text-sm text-base-content/70">
                                    <span class="font-semibold text-base-content">Hours:</span><br />
                                    {loc.hours.split(';').map((h) => h.trim()).filter(Boolean).map((h) => (
                                        <span class="block">{h}</span>
                                    ))}
                                </div>

                                {loc.facilityTypes.length > 0 && (
                                    <div class="flex flex-wrap gap-1 pt-1">
                                        {loc.facilityTypes.map((ft) => (
                                            <span class="badge badge-outline badge-sm">{ft}</span>
                                        ))}
                                    </div>
                                )}

                                {(loc.locationDetails.length > 0 || loc.pickUpAvailable) && (
                                    <div class="flex flex-wrap gap-1 pt-1">
                                        {loc.pickUpAvailable && (
                                            <span class="badge badge-success badge-sm">Pick Up Available</span>
                                        )}
                                        {loc.locationDetails.map((d) => (
                                            <span class="badge badge-info badge-sm">{d}</span>
                                        ))}
                                    </div>
                                )}

                                {loc.appointmentRequired && loc.appointmentRequired !== 'No' && (
                                    <p class="text-xs text-base-content/60 italic">{loc.appointmentRequired}</p>
                                )}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Map — only shown for single result */}
                {results.length === 1 && mapAddress && (
                    <div class="lg:w-1/2 min-h-96 lg:min-h-0">
                        <iframe
                            title="Location map"
                            width="100%"
                            height="100%"
                            style="min-height: 400px; border: 0;"
                            loading="lazy"
                            allowfullscreen
                            src={`https://maps.google.com/maps?q=${mapAddress}&output=embed`}
                        />
                    </div>
                )}
            </div>
        </div>
    )}

    {!zip && (
        <p class="text-base-content/50 text-sm mb-8">Enter a ZIP code below to find nearby locations.</p>
    )}

    <form
        x-data="{}"
        x-on:submit.prevent="window.location.href = '/location/' + $el.querySelector('#zip').value.trim() + '/'"
        class="flex gap-3 items-end"
    >
        <div class="flex flex-col gap-1">
            <label for="zip" class="text-sm font-semibold">Enter ZIP Code</label>
            <input
                id="zip"
                name="zip"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{5}"
                maxlength="5"
                placeholder="e.g. 86401"
                value={zip}
                class="input input-bordered w-48"
                required
            />
        </div>
        <button type="submit" class="btn btn-primary">Find Locations</button>
        {zip && <a href="/location/" class="btn btn-ghost">Clear</a>}
    </form>

</div>
