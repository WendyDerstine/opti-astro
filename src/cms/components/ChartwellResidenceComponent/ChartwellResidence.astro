---
import type { DisplaySettingsFragment } from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';

export interface Props {
    key: string;
    data: any;
    contentPayload: ContentPayload;
    displaySettings: DisplaySettingsFragment[];
}

const { key } = Astro.props as Props;
const isCmsEdit = isEditContext(Astro.url);

const API_BASE = 'https://wenoptiapi.netlify.app/.netlify/functions/chartwell-locations';

// Read slug from URL: /find-a-residence/ontario/aurora/hollandview-trail/ → "hollandview-trail"
const pathParts = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const residenceSlug = pathParts[pathParts.length - 1] ?? '';

interface Location {
    id: number;
    name: string;
    city: string;
    address: string;
    phone: string;
    careTypes: string[];
    slug: string;
    imageUrl: string;
    tagline: string;
    description: string;
}

let location: Location | null = null;
let error = false;

try {
    const res = await fetch(`${API_BASE}?slug=${encodeURIComponent(residenceSlug)}`);
    if (res.ok) {
        const json = await res.json();
        location = json.location ?? null;
    } else {
        error = true;
    }
} catch {
    error = true;
}

const careTypeColors: Record<string, string> = {
    'Independent Living': 'bg-emerald-100 text-emerald-800',
    'Assisted Living':    'bg-sky-100 text-sky-800',
    'Memory Care':        'bg-amber-100 text-amber-800',
    'Long Term Care':     'bg-red-100 text-red-800',
    'Seniors Apartments': 'bg-gray-100 text-gray-700',
    'Townhouse':          'bg-gray-100 text-gray-700',
};

const citySlug = location ? location.city.toLowerCase().replace(/\s+/g, '-') : '';
---

<div
    class="component-chartwell-residence w-full"
    data-epi-block-id={isCmsEdit && key || undefined}
>

    {error && (
        <div class="max-w-screen-xl mx-auto px-4 py-16">
            <div class="alert alert-error max-w-lg">
                <span>Unable to load residence information. Please try again later.</span>
            </div>
        </div>
    )}

    {!error && !location && (
        <div class="max-w-screen-xl mx-auto px-4 py-16">
            <div class="alert alert-warning max-w-lg">
                <span>Residence not found.</span>
            </div>
        </div>
    )}

    {location && (
        <>
            {/* Hero image */}
            <div class="relative w-full h-[480px] overflow-hidden">
                {location.imageUrl ? (
                    <img
                        src={location.imageUrl}
                        alt={location.name}
                        class="w-full h-full object-cover"
                    />
                ) : (
                    <div class="w-full h-full bg-[#1a3a2a]"></div>
                )}
                <div class="absolute inset-0 bg-black/30"></div>
                <div class="absolute bottom-0 left-0 right-0 px-6 py-8 bg-gradient-to-t from-black/70 to-transparent">
                    <div class="max-w-screen-xl mx-auto 2xl:px-0">
                        <nav class="text-sm text-white/70 mb-2">
                            <a href="/find-a-residence/" class="hover:text-white">Find a Residence</a>
                            <span class="mx-2">/</span>
                            <a href={`/find-a-residence/ontario/${citySlug}/`} class="hover:text-white capitalize">{location.city}</a>
                            <span class="mx-2">/</span>
                            <span class="text-white/90">{location.name}</span>
                        </nav>
                        <h1 class="text-3xl md:text-4xl font-bold text-white">{location.name}</h1>
                    </div>
                </div>
            </div>

            {/* CTA bar */}
            <div class="w-full bg-[#6b2d6b] text-white py-4 px-6">
                <div class="max-w-screen-xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 2xl:px-0">
                    <p class="text-sm text-white/90">Visit us today and see why now is the right time to embrace senior living.</p>
                    <a
                        href={`https://www.chartwell.com/on/${citySlug}/${location.slug}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm bg-white text-[#6b2d6b] hover:bg-white/90 border-0 font-semibold shrink-0"
                    >
                        Book a Personalized Tour
                    </a>
                </div>
            </div>

            {/* Content */}
            <div class="max-w-screen-xl mx-auto px-4 py-12 2xl:px-0">

                {/* Address + phone */}
                <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-8 text-sm text-base-content/70">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#6b2d6b]" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                        </svg>
                        <span>{location.address}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#6b2d6b]" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                        </svg>
                        <a href={`tel:${location.phone}`} class="text-[#6b2d6b] font-medium hover:underline">{location.phone}</a>
                    </div>
                </div>

                {/* Care type badges */}
                <div class="flex flex-wrap gap-2 mb-8">
                    {location.careTypes.map((ct) => (
                        <span class:list={['px-3 py-1 rounded-full text-xs font-semibold', careTypeColors[ct] ?? 'bg-gray-100 text-gray-700']}>
                            {ct}
                        </span>
                    ))}
                </div>

                {/* Tagline */}
                {location.tagline && (
                    <p class="text-2xl md:text-3xl font-light text-[#6b2d6b] leading-snug mb-6 max-w-3xl">
                        {location.tagline}
                    </p>
                )}

                {/* Description */}
                {location.description && (
                    <p class="text-base text-base-content/80 leading-relaxed max-w-3xl mb-10">
                        {location.description}
                    </p>
                )}

                {/* CTA button */}
                <a
                    href={`https://www.chartwell.com/on/${citySlug}/${location.slug}/`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn bg-[#6b2d6b] text-white hover:bg-[#5a2558] border-0"
                >
                    Explore Living Options
                </a>
            </div>
        </>
    )}

</div>
