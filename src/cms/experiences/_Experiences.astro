---
import type { BlankExperience, Locales } from '../../../__generated/sdk';
import { getOptimizelySdk } from '../../graphql/getSdk';
import type { ContentPayload } from '../../graphql/shared/ContentPayload';
import Layout from '../../layouts/Layout.astro';
import Section from '../compositions/Section/Section.astro';
const previewPayload = Astro.props.data as ContentPayload;

// Resolve site settings and styles for this page.
// 1. Start with the hostname-based defaults (same lookup Layout.astro does for other page types).
// 2. Then check every URL segment as a potential "<segment>.override" key in parallel.
// 3. If any segment matches a CMS item, its settings/styles win over the hostname defaults.
// The final resolved values are passed to Layout, which skips its own hostname lookup.
const { host } = Astro.url;
const currentPath = Astro.url.pathname;
const segments = currentPath.split('/').filter(Boolean);

const [hostSettingsResult, hostStylesResult, ...segmentResults] = await Promise.all([
    getOptimizelySdk(previewPayload).siteSettingsByHostname({
        domain: host,
        locale: [previewPayload.loc as Locales],
    }),
    getOptimizelySdk(previewPayload).siteStylesByHostname({
        domain: host,
        locale: [previewPayload.loc as Locales],
    }),
    ...segments.map(seg => Promise.all([
        getOptimizelySdk(previewPayload).siteSettingsByHostname({
            domain: `${seg}.override`,
            locale: [previewPayload.loc as Locales],
        }),
        getOptimizelySdk(previewPayload).siteStylesByHostname({
            domain: `${seg}.override`,
            locale: [previewPayload.loc as Locales],
        }),
    ])),
]);

// Start from hostname defaults, then overlay with the first matching segment override
let resolvedSiteSettings = hostSettingsResult;
let resolvedSiteStyles = hostStylesResult;

for (const segResult of segmentResults as [any, any][]) {
    const [segSettings, segStyles] = segResult;
    if (segSettings?.SiteSettings?.item || segStyles?.SiteStyles?.item) {
        resolvedSiteSettings = {
            SiteSettings: { item: { ...hostSettingsResult?.SiteSettings?.item, ...segSettings?.SiteSettings?.item } }
        };
        resolvedSiteStyles = {
            SiteStyles: { item: { ...hostStylesResult?.SiteStyles?.item, ...segStyles?.SiteStyles?.item } }
        };
        break;
    }
}

const optiResponse = await getOptimizelySdk(previewPayload).getExperience({
    key: previewPayload.key,
    ver: previewPayload.ver,
    loc: previewPayload.loc as Locales,
});

const experience = optiResponse?._Experience?.item;
if (!experience) {
    throw new Error('No experience found');
}
let metaTitle = '',
    metaDescription = '',
    metaIndexing = false,
    metaGraphType = 'website',
    extPreviewEnabled = false;
if (experience?._metadata?.types?.includes('BlankExperience')) {
    const blankExperience = experience as BlankExperience;
    metaTitle =
        blankExperience.BlankExperienceSeoSettings?.MetaTitle ||
        experience?._metadata?.displayName ||
        '';
    metaDescription =
        blankExperience.BlankExperienceSeoSettings?.MetaDescription || '';
    metaIndexing =
        blankExperience.BlankExperienceSeoSettings?.Indexing || false;
    metaGraphType =
        blankExperience.BlankExperienceSeoSettings?.GraphType || 'website';
    extPreviewEnabled =
        blankExperience.PageAdminSettings?.EnableExternalPreview ?? false;
}

const defaultUrl = experience?._metadata?.url?.default || '';
const hierarchicalUrl =
    experience?._metadata?.url?.type === 'SIMPLE'
        ? experience?._metadata?.url?.hierarchical
        : '';
        
const pageClass = 'page-experience';
---

<Layout
    title={metaTitle}
    description={metaDescription}
    indexing={metaIndexing}
    graphtype={metaGraphType}
    contentPayload={previewPayload}
    defaultUrl={defaultUrl}
    hierarchicalUrl={hierarchicalUrl ?? ''}
    extPreviewEnabled={extPreviewEnabled}
    resolvedSiteSettings={resolvedSiteSettings}
    resolvedSiteStyles={resolvedSiteStyles}
>
    <div class={`vb:outline relative w-full flex-1 ${pageClass}`}>
        {
            experience?.composition?.grids?.map((grid: any) => (
                <Section contentPayload={previewPayload} grid={grid} />
            ))
        }
    </div>
</Layout>
